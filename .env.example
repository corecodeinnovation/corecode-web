NEXT_PUBLIC_SITE_URL=https://corecodeinnovation.com
NOTIFY_WEBHOOK_URL=http://ops-notify-bot:3001/webhook
NOTIFY_WEBHOOK_SECRET=
# Analítica (Umami, cloud o self-hosted; opcional): si ambas están vacías no se inyecta el script.
# Se leen en build, no en runtime — con Docker, además, copiar estas dos en un
# `.env` (sin sufijo) en la raíz: docker-compose las pasa como --build-arg
# (ver Dockerfile) para no atar el repo a una cuenta de analítica concreta.
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
