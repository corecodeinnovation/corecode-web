{
  "name": "corecode-web",
  "version": "1.1.0",
  "description": "Web corporativa de Core Code Innovation (Next.js + Tailwind).",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "^15.3.0",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.3.0",
    "jest": "^29.7.0",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.14",
    "ts-jest": "^29.4.11",
    "typescript": "^5.6.0"
  },
  "jest": {
    "testEnvironment": "node",
    "rootDir": "src",
    "clearMocks": true,
    "testRegex": "(lib|app/api)/.*\\.spec\\.ts$",
    "moduleFileExtensions": ["js", "json", "ts"],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "moduleResolution": "node",
            "strict": true,
            "esModuleInterop": true,
            "types": ["jest", "node"]
          }
        }
      ]
    }
  }
}
